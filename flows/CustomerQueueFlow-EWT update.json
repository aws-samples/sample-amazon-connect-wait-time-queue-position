  "Actions": [
    {
      "Parameters": {
        "FlowLoggingBehavior": "Enabled"
      },
      "Identifier": "enable-logging",
      "Type": "UpdateFlowLoggingBehavior",
      "Transitions": {
        "NextAction": "start-loop"
      }
    },
    {
      "Parameters": {
        "LoopCount": "20"
      },
      "Identifier": "start-loop",
      "Type": "Loop",
      "Transitions": {
        "NextAction": "invoke-lambda-ewt",
        "Conditions": [
          {
            "NextAction": "invoke-lambda-ewt",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "ContinueLooping"
              ]
            }
          },
          {
            "NextAction": "invoke-lambda-ewt",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "DoneLooping"
              ]
            }
          }
        ]
      }
    },
    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Thank you for your patience. An agent will be with you shortly."
      },
      "Identifier": "announce-fallback",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "wait-interval",
        "Errors": [
          {
            "NextAction": "wait-interval",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Thank you for waiting. We are checking your position. Your estimated wait time is approximately $.External.EstimatedWaitTimeDisplay."
      },
      "Identifier": "announce-without-position",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "wait-interval",
        "Errors": [
          {
            "NextAction": "wait-interval",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:us-east-1:123456789012:function:getEstimatedWaitTime",
        "InvocationTimeLimitSeconds": "8",
        "InvocationType": "SYNCHRONOUS",
        "ResponseValidation": {
          "ResponseType": "STRING_MAP"
        }
      },
      "Identifier": "invoke-lambda-ewt",
      "Type": "InvokeLambdaFunction",
      "Transitions": {
        "NextAction": "check-position",
        "Errors": [
          {
            "NextAction": "announce-fallback",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Parameters": {
        "TimeLimitSeconds": "30"
      },
      "Identifier": "wait-interval",
      "Type": "Wait",
      "Transitions": {
        "NextAction": "start-loop",
        "Conditions": [
          {
            "NextAction": "invoke-lambda-ewt",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "WaitCompleted"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "start-loop",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Parameters": {
        "ComparisonValue": "$.External.PositionInQueue"
      },
      "Identifier": "check-position",
      "Type": "Compare",
      "Transitions": {
        "NextAction": "announce-with-position",
        "Conditions": [
          {
            "NextAction": "announce-without-position",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "unknown"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "announce-with-position",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
